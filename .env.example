# Public — safe to expose to the browser (used by the Next.js app to build API URLs).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Server-only — Sanity write access (Editor role), used to create pending
# leaderboard entries at order-creation time. Never exposed to the client.
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Razorpay. Key secret is server-only, used to create orders and (later)
# verify webhook signatures. The key id is duplicated as a NEXT_PUBLIC_
# var because Razorpay's Checkout.js needs it in the browser — it's a
# public identifier, not a secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
