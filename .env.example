# Public — safe to expose to the browser (used by the Next.js app to build API URLs).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Server-only. Viewer-role token from sanity.io/manage -> API -> Tokens.
# Never prefix this with NEXT_PUBLIC_ and never import it from a "use client" file.
SANITY_API_READ_TOKEN=
